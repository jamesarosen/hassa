if [ -x /opt/homebrew/bin/brew ]; then eval "$(/opt/homebrew/bin/brew shellenv)"; fi

# Core PATH additions (Node comes from nvm below; Volta is opt-in)
export PATH="$HOME/.turso:$HOME/.local/bin:$PATH"

# Volta (opt-in; unmaintained — https://github.com/volta-cli/volta). Prefer nvm.
if [ -s "$HOME/.volta/bin/volta" ]; then
  export VOLTA_HOME="$HOME/.volta"
  export PATH="$VOLTA_HOME/bin:$PATH"
fi

# Node via nvm — must live in .zshenv so non-interactive shells (agents, CI helpers) get `node`.
export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && . "$NVM_DIR/nvm.sh"

# Secrets (e.g. PIHOLE_PASSWORD) live in ~/.zshenv.local — keep them out of this
# template so a failed `op` lookup cannot block Node/PATH from applying.

# pnpm (requires Node from nvm/volta above)
export PNPM_HOME="$HOME/Library/pnpm"
case ":$PATH:" in
  *":$PNPM_HOME:"*) ;;
  *) export PATH="$PNPM_HOME:$PATH" ;;
esac
# pnpm end

export SHARP_IGNORE_GLOBAL_LIBVIPS=true

# Google Cloud SDK
if [ -f "$HOME/google-cloud-sdk/path.zsh.inc" ]; then . "$HOME/google-cloud-sdk/path.zsh.inc"; fi
if [ -f "$HOME/google-cloud-sdk/completion.zsh.inc" ]; then . "$HOME/google-cloud-sdk/completion.zsh.inc"; fi

# Machine-specific overrides (not tracked by chezmoi): extra $PATH, functions, etc.
[ -r "$HOME/.zshenv.local" ] && source "$HOME/.zshenv.local"
